# Base URL of the Express auth backend. All auth endpoints live under /api/auth.
# Default when running the backend locally:
NEXT_PUBLIC_API_URL=http://localhost:4000

# IMPORTANT: the backend must set its own FRONTEND_URL to this app's origin
# (default http://localhost:3000) so the OAuth redirect lands back here at
# /auth/callback#accessToken=...&refreshToken=...
